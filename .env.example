# StudyPlan Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Load with: export $(grep -v '^#' .env | xargs) before running app.py

# ── Application ──────────────────────────────────────────────────────────────
# A strong random secret used to sign JWT tokens and email-verification tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_strong_random_hex_value

# Public URL of the application (used to build email verification links)
APP_URL=http://localhost:5000

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# SMTP server configuration for sending registration and reminder emails.
# Gmail example: use an App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=StudyPlan <your_email@gmail.com>

# ── Google Maps API ───────────────────────────────────────────────────────────
# Used to geocode university names and detect their timezone automatically.
# Get a key at https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Geocoding API + Time Zone API
MAPS_API_KEY=your_google_maps_api_key_here
